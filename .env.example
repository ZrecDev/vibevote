# Browser-safe public configuration (NEXT_PUBLIC_ prefix only)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-local-anon-key
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_ANALYTICS_WRITE_KEY=

# Server-only: never expose these in browser bundles, client components, or NEXT_PUBLIC_ variables.
SUPABASE_URL=http://127.0.0.1:55321
SUPABASE_SERVICE_ROLE_KEY=replace-with-local-service-role-key
VIBEVOTE_APP_ORIGIN=http://127.0.0.1:3000
# Optional: deployed rate-limit provider timeout in milliseconds (100-10000; defaults to 1000).
VIBEVOTE_RATE_LIMIT_TIMEOUT_MS=1000
GOOGLE_PLACES_API_KEY=
SENTRY_AUTH_TOKEN=
ANALYTICS_API_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=
