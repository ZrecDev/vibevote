# Browser-safe public configuration (NEXT_PUBLIC_ prefix only)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-local-anon-key
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_ANALYTICS_WRITE_KEY=

# Server-only: never expose these in browser bundles, client components, or NEXT_PUBLIC_ variables.
SUPABASE_SERVICE_ROLE_KEY=replace-with-local-service-role-key
GOOGLE_PLACES_API_KEY=
SENTRY_AUTH_TOKEN=
ANALYTICS_API_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=
